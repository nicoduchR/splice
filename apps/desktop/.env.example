# =================================
# Splice Desktop App Configuration
# =================================
# Copy this file to .env.local for local development

# =================================
# Billing / License
# =================================
# Set to "false" to disable billing checks (allows export without license)
# Default: "true" (billing enabled)
VITE_BILLING_ENABLED="true"

# =================================
# Backend API
# =================================
# URL of the backend API for license verification
# Local development:
VITE_API_URL="http://localhost:3001/api/v1"

# Production:
# VITE_API_URL="https://api.splice.app/api/v1"

# API Key for authenticating with backend
# Must match the API_KEY in backend-api/.env
VITE_API_KEY="your-secure-api-key-here"

# =================================
# Stripe (Frontend)
# =================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Dashboard → Developers → API keys → Publishable key
# Starts with "pk_test_" (test) or "pk_live_" (production)
#
# Note: This is the PUBLIC key, safe to include in frontend code
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (get from Dashboard → Products → Price ID)
VITE_STRIPE_PRICE_ID_MONTHLY="price_..."
VITE_STRIPE_PRICE_ID_YEARLY="price_..."
