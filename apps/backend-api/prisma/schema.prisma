// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  licenses         License[]
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("users")
}

model License {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseKey  String    @unique @map("license_key")
  plan        String    // 'free' | 'pro'
  status      String    // 'active' | 'expired' | 'revoked'
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("licenses")
}

model AppRelease {
  id               String            @id @default(uuid())
  version          String            @unique
  releaseDate      DateTime          @map("release_date")
  releaseNotes     String?           @map("release_notes") @db.Text
  isMandatory      Boolean           @default(false) @map("is_mandatory")
  platformReleases PlatformRelease[]
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([version])
  @@map("app_releases")
}

model PlatformRelease {
  id          String     @id @default(uuid())
  releaseId   String     @map("release_id")
  release     AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform    String     // 'darwin-aarch64' | 'darwin-x86_64' | 'windows-x86_64' | 'linux-x86_64'
  downloadUrl String     @map("download_url")
  signature   String     @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([releaseId, platform])
  @@index([platform])
  @@map("platform_releases")
}
