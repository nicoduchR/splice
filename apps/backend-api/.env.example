# =================================
# Splice Backend API Configuration
# =================================

# Application
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
# For local development with Docker Compose:
DATABASE_URL="postgresql://splice:splice_dev_password@localhost:5432/splice_license"

# For production (update with your database URL):
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# =================================
# Stripe Configuration
# =================================
# Get these from: https://dashboard.stripe.com/test/apikeys
#
# STRIPE_SECRET_KEY:
#   - Dashboard → Developers → API keys → Secret key
#   - Starts with "sk_test_" (test) or "sk_live_" (production)
#
# STRIPE_WEBHOOK_SECRET:
#   - Dashboard → Developers → Webhooks → Add endpoint
#   - URL: https://your-api.com/api/v1/stripe/webhook
#   - Events to send: customer.subscription.created, customer.subscription.updated,
#                     customer.subscription.deleted, checkout.session.completed
#   - After creating, click "Reveal" on the signing secret
#   - Starts with "whsec_"
#
# For local testing with Stripe CLI:
#   stripe listen --forward-to localhost:3001/api/v1/stripe/webhook
#   (The CLI will give you a temporary whsec_ secret)

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (create in Dashboard → Products)
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# =================================
# API Security
# =================================
# Generate a secure random key: openssl rand -hex 32
API_KEY="your-secure-api-key-here"

# Rate Limiting (requests per minute)
API_RATE_LIMIT_TTL=60
API_RATE_LIMIT_LIMIT=100

# CORS (comma-separated origins for production)
# In production, set to your app's domain or Tauri app identifier
CORS_ORIGIN="*"
